{
  "name": "teachapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:api": "wrangler deploy"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "radix-ui": "^1.6.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "lucide-react": "^1.31.0",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@cloudflare/workers-types": "4.20260515.1",
    "wrangler": "4.92.0",
    "@tailwindcss/postcss": "4.2.1",
    "postcss": "^8.5.6"
  }
}
